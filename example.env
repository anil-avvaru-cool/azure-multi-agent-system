# azure-multi-agent-system — environment configuration
# Copy to .env and fill in values. Never commit .env to source control.
# All values are required (fail-fast, no defaults) — see config/settings.py.
# Auth is Entra ID / DefaultAzureCredential throughout (az login locally,
# managed identity once hosted) — no API keys are read from this file.

# ── Azure AI Foundry project (agent runtime) ──────────────────────────────────
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# ── Azure OpenAI (embeddings for search/ingest.py) ────────────────────────────
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Azure AI Search ─────────────────────────────────────────────────────────
# Reached directly via AzureAISearchContextProvider (endpoint + Entra ID
# credential) — no Foundry connection resource required.
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=auto_policy_documents
